// Cloudflare Workers with static assets: the built site in dist/ is served as
// files, and only /feed.ics runs the Worker (src/worker.ts, built into
// dist-worker/ by `npm run build`).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "solar-calendar",
  "compatibility_date": "2026-10-17",
  "main": "dist-worker/worker.js",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/feed.ics"]
  },
  // Workers Builds runs `wrangler preview` for branches other than main, which
  // needs this block; everything above applies to previews as it is
  "previews": {}
}
